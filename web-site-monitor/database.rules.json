{
  "rules": {
    ".read": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous'",
    ".write": false,
    "Temperature": {
      ".write": "auth != null && auth.token.device === true && newData.exists()",
      ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 125"
    },
    "Humidity": {
      ".write": "auth != null && auth.token.device === true && newData.exists()",
      ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
    },
    "humidityAlert": {
      ".write": "auth != null && auth.token.device === true && newData.exists()",
      ".validate": "newData.val() === 0 || newData.val() === 1"
    },
    "ledStatus": {
      ".write": "auth != null && auth.token.firebase.sign_in_provider != 'anonymous' && newData.exists()",
      ".validate": "newData.val() === 0 || newData.val() === 1"
    },
    "$other": {
      ".validate": false
    }
  }
}
